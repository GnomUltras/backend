        "mode": "html",
        "content": "<div style=\"background:#05060f;min-height:88vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;font-family:'Courier New',monospace;padding:2vw;box-sizing:border-box;\"><div style=\"font-size:4.5vw;font-weight:bold;color:#7fe9ff;letter-spacing:0.3vw;margin:1.2vw 0;\">YOUR MISSION</div><div style=\"font-size:2.6vw;color:#39ff88;line-height:1.5;margin:0.9vw 0;\">Five stations are waiting for you.</div><div style=\"font-size:2.6vw;color:#39ff88;line-height:1.5;margin:0.9vw 0;\">At each station, you and your teammates will face a different challenge.</div><div style=\"font-size:2.6vw;color:#39ff88;line-height:1.5;margin:0.9vw 0;\">Solve the task. Think fast. Communicate. Trust your crew.</div><div style=\"font-size:2.6vw;color:#7fe9ff;line-height:1.5;margin:0.9vw 0;\">But remember:</div><div style=\"font-size:5vw;font-weight:bold;color:#ff7a18;letter-spacing:0.3vw;margin:1.2vw 0;\">TIME IS RUNNING.</div><div style=\"font-size:2.6vw;color:#39ff88;line-height:1.5;margin:0.9vw 0;\">Your mission time will be tracked from the moment you begin until the final station is completed.</div></div><img src=\"x\" alt=\"\" style=\"display:none\"\n     onerror=\"if(location.search.indexOf('kiosk')>-1){\n       setTimeout(function(){\n         location.href=location.href.replace('space-intro-03','space-intro-04')\n       },20000)}\">",

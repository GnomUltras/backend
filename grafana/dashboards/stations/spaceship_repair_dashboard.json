      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "game-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last AS (\n  SELECT event_type, team_id FROM station_events WHERE station_id = '${station:raw}' ORDER BY created_at DESC, id DESC LIMIT 1),\nrev AS (\n  SELECT review_score FROM station_events WHERE station_id = '${station:raw}' AND review_score IS NOT NULL ORDER BY created_at DESC, id DESC LIMIT 1)\nSELECT\n  COALESCE((SELECT event_type FROM last), 'free') AS \"Status\",\n  CASE WHEN COALESCE((SELECT event_type FROM last), 'free') = 'free' THEN 'none' ELSE (SELECT team_id FROM last) END AS \"Team\",\n  COALESCE((SELECT CASE WHEN review_score >= 4 THEN '😄' WHEN review_score = 3 THEN '😐' ELSE '🙁' END FROM rev), '–') AS \"Review\"",
          "refId": "A"
        }
      ],
      "title": "${station:text}",
      "type": "stat"

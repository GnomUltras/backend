          "rawQuery": true,
          "rawSql": "SELECT s.name AS \"Station\",\n       COALESCE(h.team_name, '–') AS \"Team\",\n       COALESCE(\n         lpad(floor(EXTRACT(EPOCH FROM h.\"time\")/60)::int::text, 2, '0') || ':' ||\n         lpad((floor(EXTRACT(EPOCH FROM h.\"time\"))::int % 60)::text, 2, '0'),\n         '–') AS \"Time\"\nFROM station s\nLEFT JOIN high_score h ON h.station_id = s.station_id\nORDER BY s.routing_order",

          "rawQuery": true,
          "rawSql": "WITH ev AS (\n  SELECT station_id, team_id, event_type, created_at,\n         LEAD(created_at) OVER (PARTITION BY station_id ORDER BY created_at, id) AS ended_at\n  FROM station_events),\nrep AS (\n  SELECT station_id, team_id, EXTRACT(EPOCH FROM (ended_at - created_at)) AS secs\n  FROM ev WHERE event_type = 'occupied' AND ended_at IS NOT NULL)\nSELECT ROW_NUMBER() OVER (ORDER BY SUM(secs)) AS \"#\", team_id AS \"Team\", lpad(floor(SUM(secs)/60)::int::text,2,'0') || ':' || lpad((floor(SUM(secs))::int % 60)::text,2,'0') AS \"Total time\" FROM rep GROUP BY team_id ORDER BY 1",

      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "game-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ev AS (\n  SELECT station_id, team_id, event_type, created_at,\n         LEAD(created_at) OVER (PARTITION BY station_id ORDER BY created_at, id) AS ended_at\n  FROM station_events),\nrep AS (\n  SELECT station_id, team_id, EXTRACT(EPOCH FROM (ended_at - created_at)) AS secs\n  FROM ev WHERE event_type = 'occupied' AND ended_at IS NOT NULL)\nSELECT \"Station\",\"Team\",\"Time\" FROM (SELECT DISTINCT ON (station_id) station_id AS \"Station\", team_id AS \"Team\", lpad(floor(secs/60)::int::text,2,'0') || ':' || lpad((floor(secs)::int % 60)::text,2,'0') AS \"Time\" FROM rep ORDER BY station_id, secs) t ORDER BY \"Station\"",
          "refId": "A"
        }
      ],
      "title": "Leader Board /Stations/ – fastest repair per station",

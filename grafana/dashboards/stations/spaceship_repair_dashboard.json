          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last AS (\n  SELECT event_type, team_id FROM station_events WHERE station_id = '${station:raw}' ORDER BY created_at DESC, id DESC LIMIT 1)\nSELECT\n  COALESCE((SELECT event_type FROM last), 'free') || ' · ' || CASE WHEN COALESCE((SELECT event_type FROM last), 'free') = 'free' THEN 'none' ELSE (SELECT team_id FROM last)::text END AS \"Status\"",

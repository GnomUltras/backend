      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "game-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last AS (\n  SELECT event_type, team_id FROM station_events WHERE station_id = '${station:raw}' ORDER BY created_at DESC, id DESC LIMIT 1),\nrev AS (\n  SELECT AVG(review_score) AS avg_score FROM station_events\n  WHERE station_id = '${station:raw}' AND review_score IS NOT NULL)\nSELECT\n  COALESCE((SELECT event_type FROM last), 'free') AS \"Status\",\n  CASE WHEN COALESCE((SELECT event_type FROM last), 'free') = 'free' THEN 'none' ELSE (SELECT team_id FROM last) END AS \"Team\",\n  COALESCE((SELECT CASE WHEN avg_score >= 3.5 THEN '😄' WHEN avg_score >= 2.5 THEN '😐' ELSE '🙁' END || ' ' || ROUND(avg_score, 1) FROM rev), '–') AS \"Review\"",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "${station:text}",
      "type": "stat"
    },

          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*) FILTER (WHERE review_score = 0) AS \"Bad (0)\",\n  COUNT(*) FILTER (WHERE review_score = 1) AS \"Medium (1)\",\n  COUNT(*) FILTER (WHERE review_score = 2) AS \"Good (2)\",\n  CASE WHEN COUNT(*) FILTER (WHERE review_score IN (0,1,2)) = 0 THEN 1 ELSE 0 END AS \"No votes yet\"\nFROM station_events\nWHERE review_score IS NOT NULL AND station_id = '${station:raw}'",

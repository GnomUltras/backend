          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH st AS (SELECT unnest(string_to_array('${station:csv}', ',')) AS station_id),\ncur AS (SELECT st.station_id, COALESCE((SELECT e.event_type FROM station_events e WHERE e.station_id = st.station_id ORDER BY e.created_at DESC, e.id DESC LIMIT 1),'free') AS status FROM st)\nSELECT station_id AS \"Station\", status AS \"Status\" FROM cur ORDER BY station_id",

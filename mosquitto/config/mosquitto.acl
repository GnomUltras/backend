# Game Controller and separate time service.
user backend
topic read station/+/login
topic read station/+/start
topic read station/+/complete
topic read station/+/review
topic write station/%u/nextStation # next station is send automatically after the review is done and when we send that we set the state to idle
topic readwrite station/+/status
topic readwrite station/+/servertime


# Each station uses its MQTT username (station01 to station05) in the topic.
pattern write station/%u/login
pattern write station/%u/start
pattern write station/%u/complete
pattern write station/%u/review
pattern read station/%u/nextStation

# Status queries and replies share the same topic.
pattern readwrite station/%u/status

# Keep the separate station time service available.
pattern readwrite station/%u/servertime
